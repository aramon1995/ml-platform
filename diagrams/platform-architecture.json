  "cards": [
    {
      "dot": "cyan",
      "title": "Persistencia",
      "items": [
        "postgres: bases mlflow, optuna, prefect y app",
        "app: predictions, ground_truth y monitoring, creadas por db-init",
        "s3://data: dataset, lotes de inferencia, etiquetas y escenarios",
        "s3://mlflow: artefactos y modelos, servidos por el proxy de MLflow"
      ]
    },
    {
      "dot": "violet",
      "title": "Flows en prefect-serve",
      "items": [
        "train y select: estudios de Optuna, champions y classifier@production; select llama a POST /reload",
        "batch-inference: predicciones a la tabla predictions",
        "monitor: drift, calidad y rendimiento sobre predictions + ground_truth",
        "ingest-labels: etiquetas reales desde S3 a ground_truth"
      ]
    },
    {
      "dot": "rose",
      "title": "Alertas",
      "items": [
        "monitor emite el evento mlplatform.monitoring.alert por cada chequeo en alerta",
        "La automatización de prefect-server reacciona al evento",
        "Su acción es DoNothing hasta enlazar un bloque de notificación"
      ]
    },
    {
      "dot": "emerald",
      "title": "Desde el host",
      "items": [
        "make train / select / infer / monitor lanzan deployments",
        "uv run python -m mlplatform.* ejecuta el mismo núcleo sin Prefect",
        "lab/eda.ipynb registra el EDA en MLflow"
      ]
    }
  ]
